@@ -0,0 +1,299 @@
+// Cambium modification: durable repository seals (Apache-2.0).
+//! Durable seals across the API and admitted git pushes.
+
+#![expect(
+    clippy::too_many_lines,
+    reason = "test assertions use controlled inputs"
+)]
+
+mod common;
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use common::{Git, Server, api, commit, put};
+use enroute_api::common::v1alpha1::{ObjectId, RepoKey};
+use enroute_compute::{
+    HookCommand, HostHooks, Judgement, PreReceiveMode, PushContext, PushHooks, RefJudgement,
+};
+
+fn key(name: &str) -> RepoKey {
+    RepoKey { key: name.into() }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn sealed_trash_reclaims_an_upload_that_finishes_after_an_empty_sweep() {
+    let root = tempfile::tempdir().unwrap();
+    let mut config =
+        enroute::node::Config::local(root.path().join("data"), common::local_store(root.path()));
+    config.compute.inline_layer_bytes = 0;
+    config.compute.merge_factor = 0;
+    config.compute.sweep_interval = Duration::from_millis(100);
+    config.compute.sweep_retention = Duration::from_millis(100);
+    let server = Server::start_config(config).await;
+    let mut client = server.api_client();
+    client.create_repo("late-upload").await.unwrap();
+    client
+        .create_commit(commit(
+            "late-upload",
+            "main",
+            "before",
+            vec![put("a", "content")],
+        ))
+        .await
+        .unwrap();
+    let layers = root.path().join("store/repos/late-upload/layers");
+    let existing = std::fs::read_dir(&layers)
+        .unwrap()
+        .next()
+        .unwrap()
+        .unwrap()
+        .path();
+    let pending = std::fs::read(existing).unwrap();
+    let late = layers.join(format!(
+        "{}.layer",
+        enroute_compute::testing::new_layer_id(0)
+    ));
+    let mut repositories =
+        api::repository_service_client::RepositoryServiceClient::connect(server.api.clone())
+            .await
+            .unwrap();
+    repositories
+        .seal_repository(api::SealRepositoryRequest {
+            repo: Some(key("late-upload")),
+        })
+        .await
+        .unwrap();
+    repositories
+        .delete_repository(api::DeleteRepositoryRequest {
+            repo: Some(key("late-upload")),
+        })
+        .await
+        .unwrap();
+    assert!(
+        common::wait_until(
+            || std::fs::read_dir(&layers).is_ok_and(|mut entries| entries.next().is_none()),
+            5
+        )
+        .await
+    );
+    tokio::time::sleep(Duration::from_millis(400)).await;
+    // Model a PUT issued before sealing that finishes after an empty sweep.
+    std::fs::write(&late, pending).unwrap();
+    assert!(
+        common::wait_until(|| !late.exists(), 5).await,
+        "a late upload escaped reclamation"
+    );
+    server.node.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_sealed_repository_is_readable_but_every_write_path_refuses_it() {
+    let server = Server::start_with(|c| c.compute.merge_factor = 0).await;
+    let mut client = server.api_client();
+    let mut repositories =
+        api::repository_service_client::RepositoryServiceClient::connect(server.api.clone())
+            .await
+            .unwrap();
+    let mut refs = api::ref_service_client::RefServiceClient::connect(server.api.clone())
+        .await
+        .unwrap();
+    assert_eq!(
+        repositories
+            .seal_repository(api::SealRepositoryRequest {
+                repo: Some(key("missing"))
+            })
+            .await
+            .unwrap_err()
+            .code(),
+        tonic::Code::NotFound
+    );
+    client.create_repo("sealed").await.unwrap();
+    let first = client
+        .create_commit(commit("sealed", "main", "first", vec![put("a", "before")]))
+        .await
+        .unwrap()
+        .commit_id
+        .unwrap()
+        .hex;
+    for _ in 0..2 {
+        repositories
+            .seal_repository(api::SealRepositoryRequest {
+                repo: Some(key("sealed")),
+            })
+            .await
+            .unwrap();
+    }
+    assert_eq!(
+        client.read_file("sealed", "main", "a").await.unwrap(),
+        b"before"
+    );
+    let error = client
+        .create_commit(commit("sealed", "main", "late", vec![put("a", "after")]))
+        .await
+        .unwrap_err();
+    assert_eq!(error.code(), tonic::Code::FailedPrecondition);
+    assert_eq!(error.message(), "repository sealed");
+    let error = refs
+        .update_refs(api::UpdateRefsRequest {
+            repo: Some(key("sealed")),
+            updates: vec![api::RefUpdate {
+                refname: "refs/heads/main".into(),
+                old_object_id: Some(ObjectId { hex: first.clone() }),
+                new_object_id: None,
+            }],
+        })
+        .await
+        .unwrap_err();
+    assert_eq!(error.code(), tonic::Code::FailedPrecondition);
+    assert_eq!(error.message(), "repository sealed");
+    let git = Git::new();
+    let checkout = git.dir("checkout");
+    git.run(
+        git.home.path(),
+        &[
+            "clone",
+            "-q",
+            &server.repo_url("sealed"),
+            checkout.to_str().unwrap(),
+        ],
+    )
+    .await;
+    git.run(&checkout, &["fsck", "--strict"]).await;
+    client.create_repo("copy").await.unwrap();
+    git.run(&checkout, &["push", "-q", &server.repo_url("copy"), "main"])
+        .await;
+    assert_eq!(client.refs("copy").await.unwrap()["refs/heads/main"], first);
+    git.commit_file(&checkout, "a", "after", "late").await;
+    let (ok, _, error) = git.try_run(&checkout, &["push", "origin", "main"]).await;
+    assert!(!ok && error.contains("repository sealed"), "{error}");
+    assert_eq!(
+        client.refs("sealed").await.unwrap()["refs/heads/main"],
+        first
+    );
+    repositories
+        .delete_repository(api::DeleteRepositoryRequest {
+            repo: Some(key("sealed")),
+        })
+        .await
+        .unwrap();
+    client.create_repo("sealed").await.unwrap();
+    assert!(client.refs("sealed").await.unwrap().is_empty());
+    client
+        .create_commit(commit(
+            "sealed",
+            "main",
+            "new incarnation",
+            vec![put("a", "new")],
+        ))
+        .await
+        .unwrap();
+    assert_eq!(
+        client.read_file("sealed", "main", "a").await.unwrap(),
+        b"new"
+    );
+}
+
+#[derive(Debug, Default)]
+struct AdmittedPush {
+    admitted: tokio::sync::Notify,
+    release: tokio::sync::Notify,
+}
+
+#[async_trait::async_trait]
+impl PushHooks for AdmittedPush {
+    fn pre_receive_mode(&self) -> Option<PreReceiveMode> {
+        Some(PreReceiveMode::Commands)
+    }
+
+    async fn pre_receive(
+        &self,
+        _context: &PushContext,
+        _repo: &str,
+        commands: &[HookCommand],
+    ) -> anyhow::Result<Vec<RefJudgement>> {
+        let allowed = commands
+            .iter()
+            .map(|command| RefJudgement {
+                refname: command.refname.clone(),
+                judgement: Judgement::Allow,
+            })
+            .collect();
+        self.admitted.notify_one();
+        self.release.notified().await;
+        Ok(allowed)
+    }
+
+    async fn post_receive(
+        &self,
+        _context: &PushContext,
+        _repo: &str,
+        _commands: &[HookCommand],
+    ) -> anyhow::Result<Vec<String>> {
+        Ok(Vec::new())
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_push_admitted_before_seal_cannot_commit_after_it() {
+    let hook = Arc::new(AdmittedPush::default());
+    let server = Server::start_hooked(
+        HostHooks {
+            push: Some(hook.clone()),
+            ..HostHooks::default()
+        },
+        |c| c.compute.merge_factor = 0,
+    )
+    .await;
+    let mut client = server.api_client();
+    client.create_repo("race").await.unwrap();
+    let before = client
+        .create_commit(commit("race", "main", "before", vec![put("a", "before")]))
+        .await
+        .unwrap()
+        .commit_id
+        .unwrap()
+        .hex;
+    let git = Git::new();
+    let checkout = git.dir("checkout");
+    git.run(
+        git.home.path(),
+        &[
+            "clone",
+            "-q",
+            &server.repo_url("race"),
+            checkout.to_str().unwrap(),
+        ],
+    )
+    .await;
+    git.commit_file(&checkout, "a", "late", "late").await;
+    let push =
+        tokio::spawn(async move { git.try_run(&checkout, &["push", "origin", "main"]).await });
+    tokio::time::timeout(Duration::from_secs(10), hook.admitted.notified())
+        .await
+        .unwrap();
+    let mut repositories =
+        api::repository_service_client::RepositoryServiceClient::connect(server.api.clone())
+            .await
+            .unwrap();
+    repositories
+        .seal_repository(api::SealRepositoryRequest {
+            repo: Some(key("race")),
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        client.refs("race").await.unwrap()["refs/heads/main"],
+        before
+    );
+    hook.release.notify_one();
+    let (ok, _, error) = tokio::time::timeout(Duration::from_secs(10), push)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(!ok && error.contains("repository sealed"), "{error}");
+    assert_eq!(
+        client.refs("race").await.unwrap()["refs/heads/main"],
+        before
+    );
+}
